# Copy to .env for local docker compose. Never commit real secrets.

# mix phx.gen.secret
SECRET_KEY_BASE=

# openssl rand -base64 48
ISTHMUS_VAULT_SECRET=

# Comma-separated admin npubs for /admin
ISTHMUS_ADMIN_NPUBS=

# Public hostname. On Render, RENDER_EXTERNAL_HOSTNAME is used if PHX_HOST is unset.
PHX_HOST=localhost

# SQLite path (container / Render disk)
DATABASE_PATH=/data/isthmus.db

PORT=4567

# Local Docker without an HTTPS terminator:
CHECK_ORIGIN=false
FORCE_SSL=false

# Optional hardware / sidecar / Nostr service identity
# MeshCore ports are auto-detected (companion protocol, repeater CLI, sibling
# CDC packet port). Set these only when you need to pin a specific device:
# ISTHMUS_MESHCORE_TRANSPORT=usb
# ISTHMUS_MESHCORE_PORT=/dev/ttyACM0
# ISTHMUS_MESHCORE_BRIDGE_CLI_PORT=/dev/ttyACM0
# ISTHMUS_MESHCORE_BRIDGE_PORT=/dev/ttyACM1
# ISTHMUS_MESHCORE_TRANSPORT=ble
# ISTHMUS_MESHCORE_BLE_ADDRESS=
# Default MeshCore contact pubkey when no prior inbound peer is known (64 hex)
# ISTHMUS_MESHCORE_PEER=
# Meshtastic companions are auto-detected (serial protobuf want_config) after
# MeshCore roles. Pin only to choose the primary radio when several are attached:
# ISTHMUS_MESHTASTIC_PORT=/dev/ttyUSB0
# ISTHMUS_RNS_SIDECAR=./sidecar/rns_sidecar.py
# Dedicated RNS config (do NOT point at MeshChatX ~/.reticulum)
# ISTHMUS_RNS_CONFIGDIR=~/.isthmus/reticulum
# ISTHMUS_RNS_STORAGE=~/.isthmus/reticulum/lxmf_storage
# Unix socket for MeshChatX IsthmusInterface (RNS-over-MeshCore tunnels)
# ISTHMUS_RNS_SOCKET=/tmp/isthmus.sock
# Reticulum-carrier tunnels use addressed (point-to-point) delivery by default.
# Set to 0/false/no/off to force the legacy broadcast path.
# ISTHMUS_TUNNEL_ADDRESSED=1
# Fallback LXMF destination for Nostr→RNS when no prior peer is known (32 hex)
# ISTHMUS_RNS_PEER=
# ISTHMUS_RNS_NODE_NAME=isthmus
# nostr service key for DM bridging (nsec1...)
# ISTHMUS_NOSTR_NSEC=
# Directory for SIGHUP SQLite backups (defaults next to DATABASE_PATH)
# ISTHMUS_BACKUP_DIR=/data/backups

# MCP operator control plane (Streamable HTTP at /mcp). Treat like an admin password.
# ISTHMUS_MCP_TOKEN=
# ISTHMUS_MCP_ENABLED=false

# Render / production behind a TLS proxy: FORCE_SSL=true (default)
